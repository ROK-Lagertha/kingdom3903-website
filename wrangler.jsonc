{
  "name": "kingdom3903-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/news/admin",
      "/news/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "HERALD_DB",
      "database_name": "citadel-herald-db",
      "database_id": "a35fc252-3112-4754-b5a0-d7efc6473a41"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HERALD_IMAGES",
      "bucket_name": "citadel-herald-images"
    }
  ]
}
